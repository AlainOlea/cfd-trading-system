# CFD Trading System - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# Bitso API (Cryptocurrency Exchange - Optional)
BITSO_API_KEY=your_bitso_api_key_here
BITSO_API_SECRET=your_bitso_api_secret_here

# OANDA API (Forex Broker - Optional, for future integration)
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_API_KEY=your_oanda_api_key

# Interactive Brokers (Optional, for future integration)
IB_ACCOUNT=your_ib_account

# Email Alerts (Optional)
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=destination_email@gmail.com

# Telegram Alerts (Optional)
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Message your bot, then visit: https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id in the response JSON
# 3. Set TELEGRAM_ALERTS_ENABLED=True in config/settings.py
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# News Analysis API Keys (Optional - for signal context and sentiment analysis)
# NewsAPI: Get free API key from https://newsapi.org
# Usage: Fetch recent news articles related to trading signals
NEWS_API_KEY=your_newsapi_org_api_key

# Google AI / Gemini API: Get free API key from https://ai.google.dev
# Usage: Analyze sentiment of news articles using Google's Gemini AI model
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Logging
LOG_LEVEL=INFO
DEBUG=False

# System
RANDOM_SEED=42
NUM_JOBS=4
